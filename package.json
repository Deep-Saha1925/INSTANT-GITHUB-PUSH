{
  "name": "giteasy",
  "displayName": "GITEasy",
  "description": "Automatically create and push your code to GitHub without manual work",
  "version": "1.0.0",
  "publisher": "DeepSaha-1925",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "keywords": [
    "git",
    "github",
    "push",
    "repository",
    "automation"
  ],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "giteasy.createAndPush",
        "title": "Create and Push to GitHub",
        "category": "GITEasy"
      }
    ],
    "keybindings": [
      {
        "command": "giteasy.createAndPush",
        "key": "ctrl+shift+g ctrl+shift+p",
        "mac": "cmd+shift+g cmd+shift+p"
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "node ./test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0",
    "@vscode/test-electron": "^2.0.0",
    "eslint": "^8.0.0"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "express": "^4.18.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DeepSaha-1925/giteasy.git"
  },
  "license": "MIT"
}
